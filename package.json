{
  "name": "quire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "tsc --noEmit && oxlint && vitest run",
    "deploy": "sh scripts/deploy.sh",
    "demo:data": "node --experimental-transform-types --no-warnings scripts/demo.ts",
    "demo": "QUIRE_DATA=.data-demo vite",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^30",
    "oxlint": "^1.85.0",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  },
  "description": "Markdown notes that format as you type, kept on your own Mac and reached over Tailscale"
}
